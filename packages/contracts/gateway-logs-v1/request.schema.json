{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gateway_id",
    "gateway_session_id",
    "logs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "gateway_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "gateway_session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "logs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "log_seq",
          "uptime_ms",
          "level",
          "event",
          "message",
          "truncated"
        ],
        "properties": {
          "log_seq": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "uptime_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "level": {
            "enum": [
              "DEBUG",
              "INFO",
              "WARN",
              "ERROR"
            ]
          },
          "event": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,23}$"
          },
          "message": {
            "type": "string",
            "maxLength": 383
          },
          "truncated": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
