{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kaelix:gateway:v1:waveforms-request",
  "title": "waveforms-request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gateway_id",
    "gateway_session_id",
    "upload_uptime_ms",
    "event_seq",
    "gateway_rx_uptime_ms",
    "gateway_received_at",
    "device_id",
    "device_sequence",
    "boot_count",
    "channels",
    "window_samples",
    "sample_rate_hz",
    "accel_range",
    "gyro_range",
    "dlpf",
    "burst_profile",
    "fragment_total",
    "fragments_missing",
    "samples_b64"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "gateway_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "gateway_session_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "previous_session": {
      "type": "boolean"
    },
    "upload_uptime_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "event_seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "gateway_rx_uptime_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "gateway_received_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "device_id": {
      "type": "string",
      "pattern": "^[0-9A-F]{8}$"
    },
    "device_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "boot_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "channels": {
      "type": "integer",
      "minimum": 1,
      "maximum": 63
    },
    "window_samples": {
      "enum": [
        256,
        512,
        1024,
        2048,
        4096
      ]
    },
    "sample_rate_hz": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "accel_range": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "gyro_range": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "dlpf": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "burst_profile": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "fragment_total": {
      "type": "integer",
      "minimum": 1,
      "maximum": 255
    },
    "fragments_missing": {
      "type": "array",
      "maxItems": 255,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 254
      }
    },
    "samples_b64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]*={0,2}$",
      "maxLength": 65536
    }
  }
}
