{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kaelix:gateway:v1:heartbeat-response",
  "title": "heartbeat-response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gateway_id",
    "gateway_session_id",
    "heartbeat_seq",
    "server_received_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "gateway_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "gateway_session_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "heartbeat_seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "server_received_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  }
}
