# Copy to deploy/.env and replace the values before starting Compose.
# Use a random URL-safe database password (e.g. openssl rand -hex 24).
POSTGRES_PASSWORD=
API_ADMIN_EMAIL=
# Between 12 and 72 bytes. Bootstrap creates the account, never resets it.
API_ADMIN_PASSWORD=

# API host interface; set the Mac LAN IP for a C3 bench test.
API_BIND_ADDRESS=127.0.0.1
