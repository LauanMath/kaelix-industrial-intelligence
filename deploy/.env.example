# Docker Compose: copy to deploy/.env and replace the values before starting Compose.
# Native service on macOS: copy to deploy/.env.service, fill in the last section and run
# scripts/install-launchagent.sh.

# --- Compose ---
# Use a random URL-safe database password (e.g. openssl rand -hex 24).
POSTGRES_PASSWORD=
# API host interface. The API listens on HTTP 8080 and, for gateways, on HTTPS 8443.
API_BIND_ADDRESS=127.0.0.1

# --- Both ---
API_ADMIN_EMAIL=
# Between 12 and 72 bytes. Bootstrap creates the account, never resets it.
API_ADMIN_PASSWORD=

# --- Native service on macOS ---
# Keep the quotes: the URL can contain characters special to the shell.
# DATABASE_URL='postgres://USER:PASSWORD@127.0.0.1:5432/kaelix?sslmode=disable'
# Plain HTTP with all routes, for the desktop. Keep it on loopback.
# API_ADDR=127.0.0.1:8080
# HTTPS with only the gateway routes and /healthz, for the local network.
# API_GATEWAY_ADDR=0.0.0.0:8443
# HTTPS with the collection page and only the routes it uses, for a phone on the network.
# Off when empty.
# API_WEB_ADDR=0.0.0.0:8444
# TLS certificate and secret.key. Changing the folder changes the fingerprint and locks
# paired gateways out. Default: ~/Library/Application Support/Kaelix/api
# API_DATA_DIR=
